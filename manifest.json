{
  "manifest_version": 2,
  "name": "Rashid-Thunderbird-Notepad",
  "version": "1.2.4",
  "description": "Simple note-taking in Thunderbird. Saves notes as Markdown (.md) files to any local folder. Works on Linux, Windows and macOS.",
  "author": "Inspired by penge/my-notes",
  "browser_specific_settings": {
    "gecko": {
      "id": "my-notes@thunderbird",
      "strict_min_version": "91.0"
    }
  },
  "icons": {
    "48": "icons/icon-48.svg",
    "96": "icons/icon-96.svg"
  },
  "permissions": [
    "storage",
    "tabs",
    "downloads"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_action": {
    "default_title": "Rashid-Thunderbird-Notepad",
    "default_icon": "icons/icon-48.svg"
  }
}